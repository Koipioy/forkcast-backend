rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own billing fields. All writes are server-side only.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Append-only ledger. Users can read their own entries.
    match /billingLedger/{entryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    // Reservations are internal. Users may read their own for debugging.
    match /billingReservations/{reservationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    // Top-ups are user-visible.
    match /topups/{topupId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    // Stripe event idempotency records are internal.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Infrastructure cost estimates are internal.
    match /functionCostEstimates/{estimateId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
